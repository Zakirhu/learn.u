# These are set automatically once you attach the integrations below in
# the Vercel dashboard — you don't create most of this file by hand.
#
# Project → Storage → Create Database → Postgres
#   -> adds POSTGRES_URL and friends automatically
#
# Project → Storage → Create Database → Blob
#   -> adds BLOB_READ_WRITE_TOKEN automatically
#
# You only need to set these two yourself, under
# Project → Settings → Environment Variables:

JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Used once by `npm run setup-db` to create the first admin account.
# Safe to remove from Vercel afterwards — it's only read by that script.
SEED_ADMIN_NAME=Portal Administrator
SEED_ADMIN_EMAIL=admin@dipsinstitutions.edu
SEED_ADMIN_PASSWORD=change-this-password
